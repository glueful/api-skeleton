# --- Composer ---
/vendor/
# The skeleton is a create-project template; installs resolve fresh dependencies.
/composer.lock
/composer.phar

# --- Environment files ---
/.env
/.env.*
!.env.example

# --- IDE / Editor ---
/.idea/
/.vscode/
/*.code-workspace

# --- PHPUnit / QA caches ---
/.phpunit.result.cache
.phpunit.cache/
/.php-cs-fixer.cache

# --- OS / Misc ---
.DS_Store
*.log
bootstrap/cache/

# --- Runtime artifacts ---
/:memory:
/storage/cache/*
!/storage/cache/.gitkeep
# Migration and extension-state lock files (created on first migrate:run / extensions:enable)
/storage/framework/
# The SQLite database is created empty by post-create-project-cmd and populated by
# `glueful install`. Never commit one: a shipped ledger goes stale against the framework.
/storage/database/*
!/storage/database/.gitkeep
